{
  "appId": "com.vitahsu.agentmonitor",
  "appName": "终端任务监控",
  "webDir": "www",
  "server": {
    "url": "https://monitor.vita-llm.com/portal?v=3",
    "cleartext": false,
    "allowNavigation": [
      "monitor.vita-llm.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f4fafb"
  },
  "android": {
    "backgroundColor": "#f4fafb"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2600,
      "launchAutoHide": true,
      "launchFadeOutDuration": 350,
      "backgroundColor": "#f4fafb",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "Keyboard": {
      "resize": "none"
    }
  }
}
