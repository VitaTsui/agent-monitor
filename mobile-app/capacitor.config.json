{
  "appId": "com.vitahsu.agentmonitor",
  "appName": "终端任务监控",
  "webDir": "www",
  "server": {
    "url": "https://monitor.vita-llm.com/portal",
    "cleartext": false,
    "allowNavigation": [
      "monitor.vita-llm.com"
    ]
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "backgroundColor": "#f4fafb"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2600,
      "launchAutoHide": true,
      "launchFadeOutDuration": 350,
      "backgroundColor": "#f4fafb",
      "showSpinner": true,
      "spinnerColor": "#0F9BAD",
      "iosSpinnerStyle": "small",
      "androidScaleType": "CENTER_INSIDE"
    }
  }
}
