<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的前景层。图形与 web/客户端的 icon.svg 同源：终端提示符 `>` + 实心光标。
     原 64×64 的坐标按 108/64 换算并整体缩到安全区（Android 要求前景主体控制在
     中心 66dp 内，否则各家启动器的裁切形状会切掉边角）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <!-- `>` 折线：等宽描边，与 icon.svg 的 stroke-width 7 等比 -->
    <path
        android:fillColor="#fafafa"
        android:pathData="M40.5,42.4l4.7,-4.7l14.2,14.2l-14.2,14.2l-4.7,-4.7l9.5,-9.5z" />
    <!-- 光标方块 -->
    <path
        android:fillColor="#fafafa"
        android:pathData="M63.6,58.7h7.6v7.6h-7.6z" />
</vector>
