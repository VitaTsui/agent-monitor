# ===== agent-task-monitor (hub) 生产环境变量模板 =====
# 复制为同目录的 `env`，填入真实值后部署。真实的 env 含密钥，切勿入库
# （已在 .gitignore 忽略），权限应为 600、属主 agentmon。

# 监听端口（仅本机，由 Caddy 反代对外）
AM_PORT=8383
AM_HEADLESS=1

# 管理员初始账号（首次启动写入注册表；之后改这里无效，需在后管里改）
AM_USERNAME=admin
AM_PASSWORD=<设一个强口令>

# 登录加密（必须与前端 dist 内置的 CRYPTO_KEY / RSA_PUB_KEY 配对，
# 否则登录会「无请求即失败」——见 DEPLOY.md 的密钥配对说明）
AM_CRYPTO_KEY=<32 位随机串>
AM_RSA_KEY_PATH=/opt/agent-monitor/rsa_private.pem

# 访问令牌（部署固定值；不设则首启随机生成到 data 目录）
AM_ADMIN_TOKEN=<32 位随机串>
AM_AGENT_TOKEN=<32 位随机串，客户端 config.txt 需填相同值>

# 前端静态产物 + 数据目录
AM_WEB_DIST=/opt/agent-monitor/web
AM_DATA_DIR=/opt/agent-monitor/data

# 机器标识（云端 hub 本机，固定名避免每次随机）
AM_MACHINE_ID=hub-tokyo
