{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "终端任务监控",
  "version": "0.3.7",
  "identifier": "com.vitahsu.agent-monitor",
  "build": {
    "frontendDist": "../../agent-monitor-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
