# 依赖与构建产物
node_modules
dist
target

# 本地调试/测试产物
tmp
playwright
.playwright-mcp

# 私钥一律不入库。hub 的 RSA 私钥是运行时读/生成的（AM_RSA_KEY_PATH，
# 缺省落在数据目录），不再编译期嵌入，仓库里本就不该出现任何 .pem。
*.pem

# 前端环境文件：带具体部署值的那两个不入库，只留 .example 模板与公共的 .env.common。
# 真实 .env.prod 由 agent-monitor-web/scripts/write-env-prod.sh 生成（CI 也走它）。
agent-monitor-web/.env/.env.dev
agent-monitor-web/.env/.env.prod

# Claude 本地配置（保留项目级 skills）
**/.claude/*
!**/.claude/skills/

# 杂项
.DS_Store
*.log
*.tar.gz

# --- 对齐 vita-admin-starter 模板 ---
.cursor
.codex

# 忽略 .claude 本地配置，但保留项目级 skills
.claude/*
!.claude/skills/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.local
*.zip

# codebase-memory-mcp 本机索引排除（个人偏好，不入库）
.cbmignore
